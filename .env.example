# URL del backend — dentro de Docker usa el nombre del servicio
BACK_URL=http://back:10001

# Ruta del archivo SQLite dentro del contenedor back
DB_PATH=/data/database.sqlite

# Credenciales del usuario administrador
APP_USUARIO=admin
APP_PASSWORD=12345678

# Clave secreta para firmar las cookies de sesión (mínimo 32 caracteres aleatorios)
SESSION_SECRET=cambia-esto-por-una-clave-secreta-larga-y-aleatoria

# URL de Victoria Logs — dentro de Docker usa el nombre del servicio
VLOGS_URL=http://victorialogs:9428n